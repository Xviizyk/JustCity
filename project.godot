"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": false,
"meta_pressed": false,
"button_mask": 1,
"position": Vector2(67, 15),
"global_position": Vector2(76, 63),
"factor": 1.0,
"button_index": 1,
"canceled": false,
"pressed": true,
"double_click": false,
"script": null
)]
}
Right={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,
"resource_local_to_scene": false,
"resource_name": "",
"device": -1,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": false,
